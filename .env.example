# Local operator console (required)
OPERATOR_USERNAME=pilot-operator
OPERATOR_PASSWORD=replace-with-a-long-random-password
# Generate independently, for example: openssl rand -base64 48
OPERATOR_APPROVAL_SECRET=replace-with-at-least-32-random-bytes

# The console is localhost-only by default. Basic auth must never cross plain HTTP
# on a network. Only enable this behind a trusted TLS reverse proxy.
ALLOW_REMOTE_OPERATOR_CONSOLE=false

# Local SQLite state
API_MIGRATOR_DB_PATH=data/api-migrator.db

# Owner-authorized publication remains disabled unless every setting below is
# independently evidenced. Preview does not require this block.
# Use a stable non-secret identifier and an anchor path in a separate,
# owner-controlled persistent directory outside the database directory.
# API_MIGRATOR_REPLAY_STORE_ID=api-migrator-owner-replay-store-v1
# API_MIGRATOR_REPLAY_ANCHOR_PATH=/secure/persistent/api-migrator/replay.anchor
# The registry must be an owner-only canonical JSON file outside this workspace
# and may contain canonical Ed25519 SPKI PUBLIC KEY PEM values only.
# API_MIGRATOR_OWNER_KEY_REGISTRY_PATH=/secure/persistent/api-migrator/owner-keys.json
# API_MIGRATOR_PILOT_ID=pilot_sandbox_v1
# API_MIGRATOR_APPROVAL_EVIDENCE_DIGEST=sha256:REPLACE_WITH_64_LOWERCASE_HEX
# API_MIGRATOR_PRE_RUN_AUTHORIZATION_DIGEST=sha256:REPLACE_WITH_64_LOWERCASE_HEX
# API_MIGRATOR_PRE_RUN_AUTHORIZATION_EXPIRES_AT=REPLACE_WITH_UNIX_EPOCH_MILLISECONDS
# API_MIGRATOR_ENGINE_TAG=v0.1.0-pilot
# API_MIGRATOR_ENGINE_COMMIT=REPLACE_WITH_EXACT_40_OR_64_CHARACTER_COMMIT_ID
# API_MIGRATOR_COMMAND_SCOPE_DIGEST=sha256:REPLACE_WITH_64_LOWERCASE_HEX
# A runner-attestation digest is never accepted from environment configuration.
# The future trusted control plane must pass an opaque result returned by signature verification.
# API_MIGRATOR_RULESET_DIGEST=sha256:REPLACE_WITH_64_LOWERCASE_HEX
# API_MIGRATOR_REQUIRED_CI_DIGEST=sha256:REPLACE_WITH_64_LOWERCASE_HEX

# Optional GitHub App credentials for repositories where the app is installed.
# Leave this whole block commented for anonymous public-repository previews.
# Prefer an absolute path outside the workspace to an owner-only (0400/0600), non-symlink PEM file.
# API_MIGRATOR_AUTH_MODE=github-app
# GH_APP_ID=123456
# GH_APP_PRIVATE_KEY_PATH=/secure/path/api-migrator.pem
# Alternatively, secret managers may inject the PEM directly. Do not set both.
# GH_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"
# Usually omit this so the installation is resolved and checked per repository.
# GH_APP_INSTALLATION_ID=42

# Local-only alternative for repositories you control (never production):
# API_MIGRATOR_AUTH_MODE=gh-cli
