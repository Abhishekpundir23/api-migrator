# Rendered only after every placeholder has been validated as a numeric value,
# nftables identifier, or exact IP literal. The ordinary transport network is
# not the security boundary; this host output hook is.
table inet @TABLE@ {
  set allowed_v4 {
    type ipv4_addr
    flags interval
    elements = { @IPV4@ }
  }

  set allowed_v6 {
    type ipv6_addr
    flags interval
    elements = { @IPV6@ }
  }

  chain restricted_job {
    ct state invalid drop
    ip daddr @allowed_v4 tcp dport 443 accept
    ip6 daddr @allowed_v6 tcp dport 443 accept
    reject with icmpx type admin-prohibited
  }

  chain output {
    type filter hook output priority -5; policy accept;
    meta skuid @UID@ jump restricted_job
  }
}
