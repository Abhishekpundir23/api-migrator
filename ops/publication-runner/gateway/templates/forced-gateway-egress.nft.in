# Rendered only from a validated static-envoy-sni-passthrough-v1 contract.
# The runner UID has no direct transport path: all of its TCP/443 connections
# are redirected to the loopback gateway, and every other output is rejected.
# The separate gateway UID may open new connections only to the exact
# plan-bound npm address set on TCP/443.
table inet @TABLE@ {
  set npm_upstream_v4 {
    type ipv4_addr
    flags interval
@UPSTREAM_V4_ELEMENTS@
  }

  set npm_upstream_v6 {
    type ipv6_addr
    flags interval
@UPSTREAM_V6_ELEMENTS@
  }

  chain force_runner_gateway {
    type nat hook output priority dstnat; policy accept;
    meta skuid @RUNNER_UID@ meta l4proto tcp tcp dport 443 counter redirect to :@GATEWAY_PORT@ comment "api-migrator force runner through gateway"
  }

  chain restrict_job_identities {
    type filter hook output priority filter; policy accept;

    meta skuid @RUNNER_UID@ ip daddr 127.0.0.1 tcp dport @GATEWAY_PORT@ counter accept comment "api-migrator runner to IPv4 gateway"
    meta skuid @RUNNER_UID@ ip6 daddr ::1 tcp dport @GATEWAY_PORT@ counter accept comment "api-migrator runner to IPv6 gateway"
    meta skuid @RUNNER_UID@ counter reject with icmpx type admin-prohibited comment "api-migrator reject runner direct egress"

    meta skuid @GATEWAY_UID@ ip saddr 127.0.0.1 tcp sport @GATEWAY_PORT@ ct state established ct direction reply counter accept comment "api-migrator gateway IPv4 downstream response"
    meta skuid @GATEWAY_UID@ ip6 saddr ::1 tcp sport @GATEWAY_PORT@ ct state established ct direction reply counter accept comment "api-migrator gateway IPv6 downstream response"
    meta skuid @GATEWAY_UID@ ip daddr @npm_upstream_v4 tcp dport 443 counter accept comment "api-migrator gateway to exact npm IPv4"
    meta skuid @GATEWAY_UID@ ip6 daddr @npm_upstream_v6 tcp dport 443 counter accept comment "api-migrator gateway to exact npm IPv6"
    meta skuid @GATEWAY_UID@ counter reject with icmpx type admin-prohibited comment "api-migrator reject gateway non-npm egress"
  }
}
