{
  "name": "api-migrator",
  "version": "0.1.0",
  "private": true,
  "description": "API Migration Campaigns as a Service — find affected customer code, deliver tested, reviewable migration pull requests.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build --workspace @api-migrator/engine --workspace @api-migrator/db --workspace @api-migrator/app",
    "build:console": "npm run build --workspace @api-migrator/console",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "console": "npm run dev --workspace @api-migrator/console",
    "engine": "tsx packages/engine/src/cli.ts",
    "test": "echo \"(no tests yet)\" && exit 0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsx": "^4.19.0"
  }
}
